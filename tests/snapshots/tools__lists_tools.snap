---
source: tests/tools.rs
expression: text
---
[
  {
    "name": "jj_bookmark_list",
    "description": "List bookmarks and their targets (`jj bookmark list`). The default revision is not used here.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "all_remotes": {
          "default": false,
          "description": "Also show remote bookmarks, including untracked ones and ones in sync\nwith their local bookmark.",
          "type": "boolean"
        },
        "names": {
          "default": [],
          "description": "Only show bookmarks whose name matches one of these string patterns\n(glob by default).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revset": {
          "description": "Only show bookmarks pointing at commits in this revset. The default\nrevision is not used here.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for each bookmark.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_diff",
    "description": "Show the changes made in a revset (`jj diff --revisions`), in git format unless `stat`, `summary` or `name_only` is set. Use `paths` to keep the output small.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "Lines of context around each change in the patch.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name_only": {
          "default": false,
          "description": "Show only the changed file names. Only one of `stat`, `summary` and\n`name_only` can be set.",
          "type": "boolean"
        },
        "paths": {
          "default": [],
          "description": "Only show changes to these filesets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revset": {
          "description": "Revset whose changes to show. Several revisions are shown as one\ncombined diff. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "stat": {
          "default": false,
          "description": "Show a diffstat instead of the patch. Only one of `stat`, `summary`\nand `name_only` can be set.",
          "type": "boolean"
        },
        "summary": {
          "default": false,
          "description": "Show changed files with their status (A/M/D) instead of the patch.\nOnly one of `stat`, `summary` and `name_only` can be set.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_diff_range",
    "description": "Show the difference between the trees of two revisions (`jj diff --from --to`), in git format unless `stat`, `summary` or `name_only` is set. `from` and `to` are required: the default revision is not used.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "Lines of context around each change in the patch.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "from": {
          "description": "Revision to diff from. Required: the default revision is not used.",
          "type": "string"
        },
        "name_only": {
          "default": false,
          "description": "Show only the changed file names. Only one of `stat`, `summary` and\n`name_only` can be set.",
          "type": "boolean"
        },
        "paths": {
          "default": [],
          "description": "Only show changes to these filesets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stat": {
          "default": false,
          "description": "Show a diffstat instead of the patch. Only one of `stat`, `summary`\nand `name_only` can be set.",
          "type": "boolean"
        },
        "summary": {
          "default": false,
          "description": "Show changed files with their status (A/M/D) instead of the patch.\nOnly one of `stat`, `summary` and `name_only` can be set.",
          "type": "boolean"
        },
        "to": {
          "description": "Revision to diff to. Required: the default revision is not used.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_evolog",
    "description": "Show how changes evolved (`jj evolog`): their earlier versions from rewrites such as amends and rebases.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Show at most this many versions.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "no_graph": {
          "default": false,
          "description": "Show a flat list instead of a graph.",
          "type": "boolean"
        },
        "patch": {
          "default": false,
          "description": "Show the patch between each version and the one before (git format).",
          "type": "boolean"
        },
        "revset": {
          "description": "Revset whose history to show. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for each version. Keywords are on `commit`, e.g.\n`commit.commit_id()`, not `commit_id`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_file_annotate",
    "description": "Show the change that last modified each line of a file at a revision (`jj file annotate`, like `git blame`).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Path of one file (a literal path, not a fileset).",
          "type": "string"
        },
        "revision": {
          "description": "Revision to annotate the file at. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for each line.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_file_list",
    "description": "List the files at a revision (`jj file list`).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "default": [],
          "description": "Only list files matching these filesets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "description": "Revision to list the files at. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for each file.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_file_search",
    "description": "Search file contents at a revision (`jj file search`). Prints matching lines with their line numbers, or only file names if `name_only` is set.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "ignore_case": {
          "default": false,
          "description": "Match case-insensitively.",
          "type": "boolean"
        },
        "kind": {
          "default": "regex",
          "description": "`regex` (the default) matches anywhere in the line, `substring` matches\nplain text anywhere in the line, `exact` must equal the whole line, and\n`glob` must match the whole line (e.g. `*foo*`).",
          "enum": [
            "exact",
            "glob",
            "regex",
            "substring"
          ],
          "type": "string"
        },
        "name_only": {
          "default": false,
          "description": "Print only the names of matching files, not the matching lines.",
          "type": "boolean"
        },
        "paths": {
          "default": [],
          "description": "Only search files matching these filesets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pattern": {
          "description": "Text to match against each line, used as-is. Set the kind with `kind`,\nnot a `kind:` prefix.",
          "type": "string"
        },
        "revision": {
          "description": "Revision to search at. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_file_show",
    "description": "Print the contents of files at a revision (`jj file show`). When more than one path is passed each file is preceded by a `==> path <==` header, unless `template` is set.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "description": "Filesets to print.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "description": "Revision to read the files at. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for each file's header.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paths"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_help",
    "description": "Show jj's help on a topic (`jj help --keyword`). Topics: bookmarks, config, filesets, glossary, revsets, templates, tutorial.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "topic": {
          "description": "One of `bookmarks`, `config`, `filesets`, `glossary`, `revsets`,\n`templates`, `tutorial`.",
          "type": "string"
        }
      },
      "required": [
        "topic"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_interdiff",
    "description": "Compare the changes made by two revisions (`jj interdiff --from --to`): the difference between their patches, not their trees. Useful to see what changed between two versions of a change, e.g. across a rebase. In git format unless `stat`, `summary` or `name_only` is set. `from` and `to` are required: the default revision is not used.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "Lines of context around each change in the patch.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "from": {
          "description": "Revision to diff from. Required: the default revision is not used.",
          "type": "string"
        },
        "name_only": {
          "default": false,
          "description": "Show only the changed file names. Only one of `stat`, `summary` and\n`name_only` can be set.",
          "type": "boolean"
        },
        "paths": {
          "default": [],
          "description": "Only show changes to these filesets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stat": {
          "default": false,
          "description": "Show a diffstat instead of the patch. Only one of `stat`, `summary`\nand `name_only` can be set.",
          "type": "boolean"
        },
        "summary": {
          "default": false,
          "description": "Show changed files with their status (A/M/D) instead of the patch.\nOnly one of `stat`, `summary` and `name_only` can be set.",
          "type": "boolean"
        },
        "to": {
          "description": "Revision to diff to. Required: the default revision is not used.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_list_remotes",
    "description": "List the git remotes and their URLs (`jj git remote list`). Use it to find the hosting repo, e.g. the GitHub `owner/repo` for looking up a branch's pull request.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_log",
    "description": "Show the commits in a revset (`jj log`), optionally with each commit's patch, changed files or diffstat. `@` may be stale: the working copy is not snapshotted.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Show at most this many commits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "no_graph": {
          "default": false,
          "description": "Show a flat list instead of a graph.",
          "type": "boolean"
        },
        "patch": {
          "default": false,
          "description": "Show each commit's patch (git format).",
          "type": "boolean"
        },
        "reversed": {
          "default": false,
          "description": "Show the oldest commits first.",
          "type": "boolean"
        },
        "revset": {
          "description": "Revset to show. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "stat": {
          "default": false,
          "description": "Show each commit's diffstat. Can't be combined with `summary`.",
          "type": "boolean"
        },
        "summary": {
          "default": false,
          "description": "Show each commit's changed files. Can't be combined with `stat`.",
          "type": "boolean"
        },
        "template": {
          "description": "Template for each commit.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_set_default_revision",
    "description": "Set the revision used when a tool's `revset`/`revision` param is omitted. It is kept in memory for this session only. Runs `jj log` on the revision and returns its output. The default is only changed if that succeeds. Pass null or an empty string to clear the default.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "description": "Revision to use when a tool's `revset`/`revision` is omitted. Null or\nempty clears the default.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_show",
    "description": "Show a revision's description and a diffstat of its changed files (`jj show --stat`). Use jj_diff for the patch.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "revset": {
          "description": "Revset to show. Defaults to the default revision.",
          "type": [
            "string",
            "null"
          ]
        },
        "template": {
          "description": "Template for the commit header.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "jj_status",
    "description": "Show the working copy's status (`jj status`). The working copy is not snapshotted, so this is its state at the last snapshot and may be stale.",
    "inputSchema": {
      "properties": {},
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  }
]
